{
  "family": "chainlit-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::505499691662:role/ecsTaskExecutionRole",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "chainlit-container",
      "image": "505499691662.dkr.ecr.eu-north-1.amazonaws.com/docker-image:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ]
}

